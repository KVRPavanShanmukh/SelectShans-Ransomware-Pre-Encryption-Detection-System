# ============================================================
# Backend - Git Ignore
# ============================================================

# Markdown files excluded (only root README.md is pushed)
*.md
**/*.md

# Environment & secrets
.env
.env.*
!.env.example
*.key
*.pem
*.token

# Logs
logs/
**/logs/
*.log

# Node & dependencies
node_modules/
dist/
dist-ssr/
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Python bytecode & caches
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Databases & local storage
*.sqlite*
*.db

# Text file exclusion with whitelisting of requirements
*.txt
!requirements.txt
!detector_package/requirements.txt
!backend/requirements.txt
!backend/detector_package/requirements.txt

# Binaries & archives
*.zip
*.exe
bin/
obj/
**/bin/
**/obj/
