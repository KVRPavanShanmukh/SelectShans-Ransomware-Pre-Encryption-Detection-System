{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "EndpointOptions": {
    "BackendApiUrl": "http://127.0.0.1:5000",
    "DetectorToken": "YOUR_SHARED_TOKEN_HERE",
    "MonitoringWindowSeconds": 15,
    "ModificationThreshold": 20,
    "RenameThreshold": 10,
    "EntropyThreshold": 7.5,
    "QueueLimit": 10000,
    "HeartbeatIntervalSeconds": 60,
    "ProtectedFolder": "",
    "SuspiciousExtensions": [ ".locked", ".lock", ".crypt", ".encrypted", ".enc" ]
  }
}
