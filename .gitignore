# ============================================================
# SelectShans - Global Git Ignore
# ============================================================

# =========================
# Documentation & Markdown Files
# ONLY the main root README.md is allowed; ALL other .md files are excluded
# =========================
*.md
**/*.md
!/README.md

# =========================
# Environment & Secrets (STRICT)
# =========================
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
*.env
*.env.*

# Secrets, Passwords, Keys, Certificates & Tokens
*password*
*Password*
*credential*
*Credential*
*secret*.txt
*.credentials
*.key
*.pem
*.pfx
*.p12
*.cer
*.crt
*.cert
*.token
*token*.json
serviceAccountKey*.json
client_secret*.json

# =========================
# Node / React
# =========================
node_modules/
**/node_modules/
dist/
**/dist/
dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# =========================
# Python & Virtual Environments
# =========================
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
.tox/

# =========================
# Logs, Telemetry & Forensic Dumps
# =========================
logs/
**/logs/
*.log
monitor.log
sysmon*.log
audit*.log
*.dump
*.sql.bak
*.bak

# =========================
# Supabase & Local Databases
# =========================
.supabase/
supabase/.branches/
supabase/.temp/
supabase/seed.sql.tmp
*.db
*.sqlite
*.sqlite3

# =========================
# .NET, Binaries & Archives
# =========================
bin/
obj/
**/bin/
**/obj/
publish/
releases/
**/*_publish/
**/publish/
**/publish-small/
**/releases/
*.exe
*.dll
*.zip
*.tar.gz
*.7z
*.rar

# =========================
# IDE & Tooling
# =========================
.vs/
.vscode/
*.user
*.suo
*.userosscache
*.sln.docstates
.idea/

# =========================
# OS Generated Files & Temporary Exports
# =========================
.DS_Store
Thumbs.db
desktop.ini
*.tmp
*.temp
*.pdf
chart_*.png

# =========================
# Text Files & Requirements Whitelist
# =========================
*.txt
!backend/requirements.txt
!backend/detector_package/requirements.txt
